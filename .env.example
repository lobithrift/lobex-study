# Client-side Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API credential (for multimodal PDF & syllabus analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Alternative server-side LLM provider credential (OpenAI compatible)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Resend server-side credential (email reminders & login security alerts)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# Server-side Supabase admin key (optional)
SUPABASE_SERVICE_ROLE_KEY=

# Administrative Portal Secret Credentials
ADMIN_USERNAME="lobex_admin"
ADMIN_PASSWORD="YourSecureAdminPasswordHere"
